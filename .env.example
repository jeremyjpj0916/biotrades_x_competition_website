DATABASE_URL=postgresql://biotrades:biotrades@localhost:5432/biotrades
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
FIRST_COMPETITION_YEAR=2027

# Self-hosted SMTP delivery uses compose.mail.yaml. Its application SMTP settings
# are derived from MAIL_DOMAIN. SMTP_URL can also point to an existing local MTA.
MAIL_DOMAIN=
MAIL_HOSTNAME=
MAIL_DKIM_SELECTOR=biotrades
MAIL_SUBMISSION_SUBNET=172.31.95.0/28
# Leave SMTP_URL blank for email links in the local Next development log.
SMTP_URL=
MAIL_FROM=BioTrades X <no-reply@example.com>
ADMIN_EMAILS=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
DISCORD_COMMUNITY_URL=
X_COMMUNITY_URL=
DISCORD_WEBHOOK_URL=

MASSIVE_API_KEY=
MASSIVE_PUBLIC_DISPLAY_APPROVED=false
MASSIVE_REQUESTS_PER_MINUTE=5
# Leave both Yahoo credentials empty to use the public daily chart. Set both to use batch quotes.
YAHOO_FINANCE_COOKIE=
YAHOO_FINANCE_CRUMB=
YAHOO_FINANCE_PUBLIC_DISPLAY_APPROVED=false
YAHOO_FINANCE_REQUESTS_PER_MINUTE=5
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
MARKET_CLOSE_DELAY_MINUTES=30

# Default: keyless Market History returns, usually available after 48 hours.
# Official mode requires an authorized closing-price feed or verified imports.
MARKET_DATA_MODE=free
MARKET_HISTORY_REQUESTS_PER_MINUTE=2
SEC_CONTACT=

# Cloudflare Turnstile. Public deployments require their own hostname-scoped keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MARKET_HISTORY_ACTIONS_KEY=
